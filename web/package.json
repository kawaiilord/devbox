  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "puppeteer-core": "25.12.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
