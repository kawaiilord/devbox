SAMEFRAME_ADDR=:8080
SAMEFRAME_ALLOWED_ORIGINS=http://localhost:3000
SAMEFRAME_JWT_ISSUER=sameframe
SAMEFRAME_JWT_SECRET=replace-with-at-least-32-random-characters
SAMEFRAME_ALLOW_DEMO_AUTH=false
SAMEFRAME_ADMIN_EMAILS=admin@example.com
DATABASE_URL=postgres://sameframe:change-me@localhost:5432/sameframe?sslmode=disable
REDIS_URL=redis://localhost:6379/0
SAMEFRAME_NODE_ID=node-a
SAMEFRAME_REQUIRE_VERIFIED_EMAIL=true
SAMEFRAME_MAIL_WEBHOOK_URL=https://mailer.example.com/messages
SAMEFRAME_MAIL_WEBHOOK_SECRET=replace-with-mail-webhook-secret
SAMEFRAME_VAULT_KEY=base64-encoded-32-byte-master-key
SAMEFRAME_ALLOW_PRIVATE_SOURCES=false
SAMEFRAME_PUBLIC_BASE_URL=https://api.example.com
SAMEFRAME_TMDB_TOKEN=tmdb-api-read-access-token
SAMEFRAME_TURN_URLS=turns:turn.example.com:5349?transport=tcp
SAMEFRAME_TURN_SECRET=replace-with-turn-rest-shared-secret
SAMEFRAME_S3_ENDPOINT=https://s3.example.com
SAMEFRAME_S3_ACCESS_KEY=replace-with-s3-access-key
SAMEFRAME_S3_SECRET_KEY=replace-with-s3-secret-key
SAMEFRAME_S3_BUCKET=sameframe-assets
SAMEFRAME_PAYMENT_PROVIDER=hmac
SAMEFRAME_PAYMENT_CHECKOUT_URL=https://pay.example.com/checkout
SAMEFRAME_PAYMENT_CALLBACK_SECRET=replace-with-at-least-32-random-characters
SAMEFRAME_VIP_ANNOUNCEMENT=
SAMEFRAME_POINTS_PER_CHECK_IN=1
SAMEFRAME_POINTS_PER_VIP_DAY=0
